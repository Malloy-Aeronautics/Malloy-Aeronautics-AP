# T150 in SITL: what SITL needs on top of T150.param. Never load this onto an aircraft.
# Load order: default_params/copter.parm, T150.param, then this file.

# --- frame: the T150 is an octa-quad X (FRAME_CLASS 4, FRAME_TYPE 1), which is SITL's
#     "octa-quad" frame, so nothing to change. Fly it with --model octa-quad:@ROMFS/models/T150_sim.json

# --- IMUs: the Cube has three and the T150 uses the first and third (INS_ENABLE_MASK 5), so SITL
#     simulates three. The two in use need non-zero calibration to count as calibrated; the third
#     must stay uncalibrated because it isn't used.
SIM_IMU_COUNT,3
INS_ACCOFFS_X,0.001
INS_ACCOFFS_Y,0.001
INS_ACCOFFS_Z,0.001
INS_ACCSCAL_X,1.001
INS_ACCSCAL_Y,1.001
INS_ACCSCAL_Z,1.001
INS_ACC2OFFS_X,0.001
INS_ACC2OFFS_Y,0.001
INS_ACC2OFFS_Z,0.001
INS_ACC2SCAL_X,1.001
INS_ACC2SCAL_Y,1.001
INS_ACC2SCAL_Z,1.001
INS_ACC3OFFS_X,0
INS_ACC3OFFS_Y,0
INS_ACC3OFFS_Z,0
INS_ACC3SCAL_X,1
INS_ACC3SCAL_Y,1
INS_ACC3SCAL_Z,1

# --- compass and baro: SITL's own sensors
COMPASS_PRIO1_ID,97539
COMPASS_PRIO2_ID,131874
COMPASS_PRIO3_ID,263178
SIM_BARO_COUNT,2

# --- GPS: two u-blox receivers as moving baseline (GPS_TYPE 18/17 from T150.param), at the
#     T150's antenna positions. SITL can't be configured like a real receiver.
GPS_AUTO_CONFIG,0
SIM_GPS_TYPE,1
SIM_GPS2_TYPE,1
SIM_GPS2_DISABLE,0
SIM_GPS_HDG,1
SIM_GPS_POS_X,0.4
SIM_GPS_POS_Y,0
SIM_GPS_POS_Z,0
SIM_GPS2_POS_X,-0.33
SIM_GPS2_POS_Y,0
SIM_GPS2_POS_Z,0

# --- battery: SITL's analog battery, at a voltage inside the T150's range (MOT_BAT_VOLT_MIN 36 to
#     MOT_BAT_VOLT_MAX 58.8, low battery at 43.2)
BATT_VOLT_PIN,13
BATT_CURR_PIN,12
BATT_VOLT_MULT,10.1
BATT_AMP_PERVLT,17
SIM_BATT_VOLTAGE,56

# --- rangefinder: SITL's analog sonar in place of the LightWare, pointing down (SIM_SONAR_ROT is
#     down by default). It's the setup ArduPilot's own rangefinder autotests use. Its output tops out
#     at 5 V, about 60 m at this scaling, so the range is capped there instead of the LightWare's 95 m.
RNGFND1_TYPE,1
RNGFND1_PIN,0
RNGFND1_SCALING,12.12
RNGFND1_MAX_CM,6000

# --- RC: the autotests fly with throttle on channel 3, as ArduPilot's own tests expect. The T150's
#     transmitter has throttle on channel 1 (RCMAP_THROTTLE 1); that's the radio, not the aircraft.
RCMAP_ROLL,1
RCMAP_PITCH,2
RCMAP_THROTTLE,3
RCMAP_YAW,4
